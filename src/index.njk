---
permalink: /index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>{{ site.name }} | Realtor — London &amp; Southwestern Ontario</title>
<meta name="description" content="{{ site.name }}, {{ site.role }} with {{ site.brokerage }}. Helping families buy and sell homes across London, St. Thomas, Kitchener-Waterloo, and southwestern Ontario.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --sky-50:#EFF6FC; --sky-100:#DCEBF8; --sky-200:#B9D7F0; --sky-300:#8FBDE6;
  --blue-500:#2E86D6; --blue-600:#1D6AB4; --navy-800:#0C3D6E; --navy-900:#062A4F;
  --gold:#C9962E; --ink:#1B2733; --muted:#5A6B7B; --white:#FFFFFF;
  --radius:14px; --maxw:1080px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:var(--white);line-height:1.65;font-size:16px}
h1,h2,h3{font-family:'Fraunces',Georgia,serif;font-weight:500;line-height:1.2;color:var(--navy-900)}
img{max-width:100%;display:block}
a{color:var(--blue-600)}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
.eyebrow{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--blue-600);font-weight:600;margin-bottom:10px}
.btn{display:inline-block;padding:13px 26px;border-radius:10px;font-weight:600;font-size:15px;text-decoration:none;transition:transform .15s ease,box-shadow .15s ease;cursor:pointer;border:none}
.btn:hover{transform:translateY(-1px)}
.btn-primary{background:var(--blue-500);color:var(--white)}
.btn-primary:hover{background:var(--blue-600)}
.btn-outline{background:transparent;color:var(--navy-800);border:1.5px solid var(--sky-300)}
.btn-outline:hover{background:var(--sky-50)}
section{padding:76px 0}

nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--sky-100)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:66px}
.brand{font-family:'Fraunces',serif;font-size:19px;font-weight:600;color:var(--navy-900);text-decoration:none}
.brand span{color:var(--blue-500)}
.nav-links{display:flex;gap:26px;align-items:center;list-style:none}
.nav-links a{text-decoration:none;color:var(--muted);font-size:14.5px;font-weight:500}
.nav-links a:hover{color:var(--navy-800)}
.nav-links .btn{padding:9px 18px;font-size:14px}

.hero{background:linear-gradient(180deg,var(--sky-100) 0%,var(--sky-50) 100%);padding:84px 0 90px}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(34px,4.6vw,52px);margin:14px 0 18px}
.hero h1 em{font-style:italic;color:var(--blue-600)}
.hero p.lede{font-size:18px;color:var(--muted);max-width:520px;margin-bottom:30px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.hero-badges{display:flex;gap:10px;flex-wrap:wrap;margin-top:28px}
.badge{background:var(--white);border:1px solid var(--sky-200);color:var(--navy-800);font-size:13px;font-weight:500;padding:7px 14px;border-radius:999px}
.portrait-card{background:var(--white);border-radius:20px;padding:14px;box-shadow:0 24px 60px -24px rgba(12,61,110,.35);transform:rotate(1.2deg)}
.portrait-card img{border-radius:12px;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top}
.portrait-fallback{border-radius:12px;width:100%;aspect-ratio:4/5;background:var(--sky-200);display:none;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:72px;color:var(--navy-800)}
.portrait-caption{text-align:center;padding:12px 6px 4px;font-size:14px;color:var(--muted)}
.portrait-caption strong{color:var(--navy-900);display:block;font-size:15px}

.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.about h2{font-size:32px;margin-bottom:18px}
.about p{color:var(--muted);margin-bottom:16px}
.pillars{display:grid;gap:14px}
.pillar{background:var(--sky-50);border:1px solid var(--sky-100);border-radius:var(--radius);padding:20px 22px}
.pillar h3{font-size:17px;margin-bottom:5px;font-family:'Inter',sans-serif;font-weight:600;color:var(--navy-800)}
.pillar p{font-size:14.5px;color:var(--muted);margin:0}

.areas{background:var(--navy-900);color:var(--white)}
.areas .eyebrow{color:var(--sky-300)}
.areas h2{color:var(--white);font-size:30px;margin-bottom:12px}
.areas p{color:var(--sky-200);max-width:560px;margin-bottom:28px}
.area-chips{display:flex;flex-wrap:wrap;gap:11px}
.area-chips span{background:rgba(255,255,255,.08);border:1px solid rgba(185,215,240,.3);color:var(--sky-100);padding:9px 20px;border-radius:999px;font-size:14.5px;font-weight:500}

.listings-band{background:var(--sky-50);border-top:1px solid var(--sky-100);border-bottom:1px solid var(--sky-100)}
.listings-band .wrap{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap}
.listings-band h2{font-size:26px}
.listings-band p{color:var(--muted);max-width:480px}

.gallery h2{font-size:32px;margin-bottom:10px}
.gallery>.wrap>p{color:var(--muted);max-width:600px;margin-bottom:34px}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.gcard{background:var(--white);border:1px solid var(--sky-100);border-radius:var(--radius);overflow:hidden;box-shadow:0 10px 30px -18px rgba(12,61,110,.25)}
.gcard .gimg{aspect-ratio:4/3;background:var(--sky-100);display:flex;align-items:center;justify-content:center;color:var(--blue-600);font-size:14px;font-weight:500;text-align:center;padding:12px}
.gcard img{width:100%;aspect-ratio:4/3;object-fit:cover}
.gcard .gcap{padding:13px 16px;font-size:14px;color:var(--muted)}
.gcard .gcap b{color:var(--navy-900);font-weight:600}

.awards{background:var(--sky-50);border-top:1px solid var(--sky-100)}
.awards h2{font-size:32px;margin-bottom:10px}
.awards>.wrap>p{color:var(--muted);max-width:620px;margin-bottom:34px}
.awards-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:20px;align-items:start}
.acard{background:var(--white);border:1px solid var(--sky-100);border-radius:var(--radius);overflow:hidden;box-shadow:0 10px 30px -18px rgba(12,61,110,.25)}
.acard img{width:100%;aspect-ratio:4/5;object-fit:contain;background:var(--white)}
.acard .acap{padding:13px 16px;font-size:13.5px;color:var(--muted)}
.acard .acap b{color:var(--navy-900);font-weight:600;display:block}

.reviews{background:var(--sky-50)}
.reviews h2{font-size:32px;margin-bottom:10px}
.reviews>.wrap>p{color:var(--muted);max-width:620px;margin-bottom:34px}
.review-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:48px}
.rcard{background:var(--white);border-radius:var(--radius);padding:26px 28px;border:1px solid var(--sky-100)}
.stars{color:var(--gold);letter-spacing:2px;font-size:15px;margin-bottom:12px}
.rcard blockquote{font-family:'Fraunces',serif;font-size:17px;color:var(--ink);margin-bottom:16px}
.rcard .who{font-size:13.5px;color:var(--muted);font-weight:500}
.review-form{background:var(--white);border:1px solid var(--sky-200);border-radius:var(--radius);padding:32px;max-width:640px}
.review-form h3{font-size:21px;margin-bottom:6px}
.review-form>p{font-size:14.5px;color:var(--muted);margin-bottom:22px}
.review-form label{display:block;font-size:13.5px;font-weight:600;color:var(--navy-800);margin:14px 0 6px}
.review-form input,.review-form textarea,.review-form select{width:100%;padding:11px 14px;border:1.5px solid var(--sky-200);border-radius:9px;font-family:inherit;font-size:15px;color:var(--ink);background:var(--white)}
.review-form input:focus,.review-form textarea:focus,.review-form select:focus{outline:none;border-color:var(--blue-500)}
.review-form textarea{min-height:110px;resize:vertical}
.review-form .btn{margin-top:20px}
.form-note{font-size:12.5px;color:var(--muted);margin-top:12px}

.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px}
.contact h2{font-size:32px;margin-bottom:16px}
.contact-list{list-style:none;display:grid;gap:16px;margin-top:24px}
.contact-list li{display:flex;gap:14px;align-items:flex-start}
.contact-list .ico{width:40px;height:40px;border-radius:10px;background:var(--sky-100);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:18px}
.contact-list b{display:block;color:var(--navy-900);font-size:14.5px}
.contact-list span{color:var(--muted);font-size:14.5px}
.map-card{background:var(--sky-50);border:1px solid var(--sky-100);border-radius:var(--radius);padding:28px}
.map-card h3{font-size:18px;margin-bottom:14px}
.map-card p{font-size:14.5px;color:var(--muted);margin-bottom:18px}

footer{background:var(--navy-900);color:var(--sky-200);padding:44px 0;font-size:13px}
footer .wrap{display:grid;gap:14px}
footer a{color:var(--sky-300)}
.disclaimer{opacity:.75;line-height:1.7}

@media(max-width:840px){
  .hero .wrap,.about .wrap,.contact .wrap{grid-template-columns:1fr}
  .gallery-grid{grid-template-columns:1fr 1fr}
  .awards-grid{grid-template-columns:1fr 1fr}
  .review-grid{grid-template-columns:1fr}
  .nav-links li:not(:last-child){display:none}
  .portrait-card{max-width:340px;margin:0 auto}
}
@media(max-width:560px){.gallery-grid,.awards-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
.cf-label{display:block;font-size:13.5px;font-weight:600;color:var(--navy-800);margin:14px 0 6px}
.cf-input{width:100%;padding:11px 14px;border:1.5px solid var(--sky-200);border-radius:9px;font-family:inherit;font-size:15px;color:var(--ink);background:var(--white)}
.cf-input:focus{outline:none;border-color:var(--blue-500)}
.cf-textarea{min-height:100px;resize:vertical}
.hidden-field{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <a class="brand" href="#top">Bijoy <span>Vellanickal</span></a>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#areas">Areas</a></li>
      {% if collections.gallery.length %}<li><a href="#gallery">Happy clients</a></li>{% endif %}
      <li><a href="#awards">Recognition</a></li>
      <li><a href="#reviews">Reviews</a></li>
      <li><a class="btn btn-primary" href="#contact">Contact</a></li>
    </ul>
  </div>
</nav>

<header class="hero" id="top">
  <div class="wrap">
    <div>
      <p class="eyebrow">{{ site.brokerage }} · London, Ontario</p>
      <h1>{{ site.headline | safe }}</h1>
      <p class="lede">{{ site.lede }}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="{{ site.listingsUrl }}" target="_blank" rel="noopener">View my listings</a>
        <a class="btn btn-outline" href="tel:{{ site.phoneDirectHref }}">Call {{ site.phoneDirect }}</a>
      </div>
      <div class="hero-badges">
        <span class="badge">{{ site.role }}</span>
        <span class="badge">First-time buyer specialist</span>
        <span class="badge">Malayalam · English</span>
      </div>
    </div>
    <div>
      <div class="portrait-card">
        <img src="/images/bijoy-headshot.jpg" alt="{{ site.name }}, Realtor" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div class="portrait-fallback">BV</div>
        <p class="portrait-caption"><strong>{{ site.name }}</strong>Your realtor in London &amp; beyond</p>
      </div>
    </div>
  </div>
</header>

<section class="about" id="about">
  <div class="wrap">
    <div>
      <p class="eyebrow">About Bijoy</p>
      <h2>Real estate that feels like family</h2>
      <p>{{ site.name }} is a {{ site.role }} with {{ site.brokerage }}, serving London and communities across southwestern Ontario. His deep understanding of these vibrant neighbourhoods, combined with genuine passion for real estate, makes him the ideal partner in your home-buying or selling journey.</p>
      <p>What sets Bijoy apart is how he communicates — like a family member, not a salesperson. His calm demeanor and deep market knowledge turn what could be a stressful process into something simple and smooth. He answers questions at every step, gives sound advice, and stays there to guide you long after the deal closes.</p>
      <p>Many first-time homebuyers and sellers share the same story: dedication, patience, and a process that felt easy from start to finish.</p>
    </div>
    <div class="pillars">
      <div class="pillar"><h3>Patient guidance</h3><p>Especially for first-time buyers — no rushing, no pressure, every question answered.</p></div>
      <div class="pillar"><h3>Deep local knowledge</h3><p>From London to the GTA, Bijoy knows the neighbourhoods, the markets, and the values.</p></div>
      <div class="pillar"><h3>There after the sale</h3><p>The relationship doesn&rsquo;t end at closing. Bijoy stays available for advice long after you get the keys.</p></div>
      <div class="pillar"><h3>Community roots</h3><p>A trusted realtor in the Malayali community, serving clients in Malayalam and English.</p></div>
    </div>
  </div>
</section>

<section class="areas" id="areas">
  <div class="wrap">
    <p class="eyebrow">Where I work</p>
    <h2>Serving southwestern Ontario and the GTA</h2>
    <p>Whether you&rsquo;re buying your first home, upsizing for a growing family, or investing, Bijoy covers these communities:</p>
    <div class="area-chips">
      {% for area in site.areas %}<span>{{ area }}</span>{% endfor %}
    </div>
  </div>
</section>

<section class="listings-band">
  <div class="wrap">
    <div>
      <h2>Looking for your next home?</h2>
      <p>Browse Bijoy&rsquo;s active listings and search every MLS property on his official RE/MAX page.</p>
    </div>
    <a class="btn btn-primary" href="{{ site.listingsUrl }}" target="_blank" rel="noopener">Search listings on RE/MAX ↗</a>
  </div>
</section>

{% if collections.gallery.length %}
<section class="gallery" id="gallery">
  <div class="wrap">
    <p class="eyebrow">Closing day</p>
    <h2>Happy families, new keys</h2>
    <p>Nothing beats the moment a family gets the keys to their new home. Here are a few of those days.</p>
    <div class="gallery-grid">
      {% for item in collections.gallery %}
      <div class="gcard">
        <img src="{{ item.data.photo }}" alt="{{ item.data.alt }}" loading="lazy">
        <div class="gcap"><b>{{ item.data.caption }}</b>{% if item.data.subcaption %} — {{ item.data.subcaption }}{% endif %}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="awards" id="awards">
  <div class="wrap">
    <p class="eyebrow">Recognition</p>
    <h2>Award-winning service</h2>
    <p>Consistently recognized among the top-performing realtors — a reflection of the families who trusted Bijoy with their move.</p>
    <div class="awards-grid">
      <div class="acard">
        <img src="/images/award-8-realtor-june-2025.jpg" alt="{{ site.name }} named #8 Realtor for June 2025, {{ site.brokerage }}" loading="lazy">
        <div class="acap"><b>#8 Realtor — June 2025</b>{{ site.brokerage }}</div>
      </div>
      <div class="acard">
        <img src="/images/award-top-performers-feb-2025.jpg" alt="Top Sales Performers February 2025 — {{ site.name }} ranked 4th" loading="lazy">
        <div class="acap"><b>Top Sales Performer</b>February 2025</div>
      </div>
      <div class="acard">
        <img src="/images/award-top-performers-oct-2023.jpg" alt="Top Sales Performers October 2023 — {{ site.name }} ranked 3rd" loading="lazy">
        <div class="acap"><b>Top Sales Performer</b>October 2023</div>
      </div>
      <div class="acard">
        <img src="/images/award-top-performers-sep-2023.jpg" alt="Top Sales Performers September 2023 — {{ site.name }} ranked 5th" loading="lazy">
        <div class="acap"><b>Top Sales Performer</b>September 2023</div>
      </div>
    </div>
  </div>
</section>

<section class="reviews" id="reviews">
  <div class="wrap">
    <p class="eyebrow">Reviews</p>
    <h2>What clients say</h2>
    <p>Real words from families Bijoy has helped buy and sell across southwestern Ontario.</p>
    {% if collections.reviews.length %}
    <div class="review-grid">
      {% for r in collections.reviews %}
      <div class="rcard">
        <div class="stars">{{ r.data.rating | stars }}</div>
        <blockquote>&ldquo;{{ r.data.quote }}&rdquo;</blockquote>
        <p class="who">— {{ r.data.name }}{% if r.data.location %}, {{ r.data.location }}{% endif %}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="review-form">
      <h3>Worked with Bijoy? Share your experience</h3>
      <p>Reviews are read by Bijoy before they appear on this page.</p>
      <form name="review" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/">
        <input type="hidden" name="form-name" value="review">
        <p class="hidden-field"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <label for="rname">Your name</label>
        <input id="rname" name="name" type="text" placeholder="Anna &amp; Jos, London" required>
        <label for="remail">Your email</label>
        <input id="remail" name="email" type="email" placeholder="you@example.com" required>
        <label for="rrating">Rating</label>
        <select id="rrating" name="rating">
          <option value="5">★★★★★ — Excellent</option>
          <option value="4">★★★★ — Great</option>
          <option value="3">★★★ — Good</option>
        </select>
        <label for="rtext">Your review</label>
        <textarea id="rtext" name="review" placeholder="Tell others about your experience buying or selling with Bijoy…" required></textarea>
        <button class="btn btn-primary" type="submit">Send review</button>
        <p class="form-note">Your review goes to Bijoy first. With your permission it may appear on this page.</p>
      </form>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Let&rsquo;s find your home</h2>
      <p style="color:var(--muted)">Reach out any time — by phone, WhatsApp, or through the brokerage. Bijoy is always happy to answer questions, no obligation.</p>
      <ul class="contact-list">
        <li><div class="ico">📞</div><div><b>Direct</b><span><a href="tel:{{ site.phoneDirectHref }}">{{ site.phoneDirect }}</a></span></div></li>
        <li><div class="ico">🏢</div><div><b>Office</b><span><a href="tel:{{ site.phoneOfficeHref }}">{{ site.phoneOffice }}</a> ({{ site.brokerage }})</span></div></li>
        <li><div class="ico">📍</div><div><b>Address</b><span>{{ site.address }}</span></div></li>
        <li><div class="ico">💬</div><div><b>Facebook</b><span><a href="{{ site.facebook }}" target="_blank" rel="noopener">facebook.com/bijoyvellanickal</a></span></div></li>
        <li><div class="ico">🏠</div><div><b>Listings</b><span><a href="{{ site.listingsUrl }}" target="_blank" rel="noopener">My RE/MAX agent page</a></span></div></li>
      </ul>
    </div>
    <div class="map-card">
      <h3>Send a quick message</h3>
      <p>Bijoy usually replies the same day.</p>
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/">
        <input type="hidden" name="form-name" value="contact">
        <p class="hidden-field"><label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
        <label for="cname" class="cf-label">Your name</label>
        <input id="cname" name="name" type="text" class="cf-input" required>
        <label for="cemail" class="cf-label">Your email</label>
        <input id="cemail" name="email" type="email" class="cf-input" required>
        <label for="cmsg" class="cf-label">Message</label>
        <textarea id="cmsg" name="message" class="cf-input cf-textarea" placeholder="I&rsquo;m looking to buy in London this fall…" required></textarea>
        <button class="btn btn-primary" type="submit" style="margin-top:18px">Send message</button>
      </form>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div><strong style="color:var(--white)">{{ site.name }}</strong> · {{ site.role }} · {{ site.brokerage }}, Brokerage</div>
    <div>{{ site.address }} · <a href="tel:{{ site.phoneDirectHref }}">{{ site.phoneDirect }}</a> · <a href="tel:{{ site.phoneOfficeHref }}">{{ site.phoneOffice }}</a></div>
    <p class="disclaimer">Each RE/MAX office is independently owned and operated. The trademarks REALTOR®, REALTORS® and the REALTOR® logo are controlled by The Canadian Real Estate Association (CREA) and identify real estate professionals who are members of CREA. The trademarks MLS®, Multiple Listing Service® and the associated logos are owned by CREA and identify the quality of services provided by real estate professionals who are members of CREA. Not intended to solicit properties currently listed for sale or buyers under contract.</p>
  </div>
</footer>

<!-- Netlify Identity widget: catches the #invite_token / #recovery_token in
     emailed links and redirects the user into /admin to set their password.
     Without this, invite links land on the homepage and appear to do nothing. -->
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", function (user) {
    if (!user) {
      window.netlifyIdentity.on("login", function () {
        document.location.href = "/admin/";
      });
    }
  });
}
</script>
</body>
</html>
