<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title>Thank you | {{ site.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--sky-50:#EFF6FC;--sky-100:#DCEBF8;--sky-200:#B9D7F0;--sky-300:#8FBDE6;--blue-500:#2E86D6;--blue-600:#1D6AB4;--navy-800:#0C3D6E;--navy-900:#062A4F;--ink:#1B2733;--muted:#5A6B7B;--white:#FFFFFF}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);background:linear-gradient(180deg,var(--sky-100) 0%,var(--sky-50) 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;line-height:1.65}
.card{background:var(--white);border-radius:20px;padding:48px 40px;max-width:520px;text-align:center;box-shadow:0 24px 60px -24px rgba(12,61,110,.35)}
h1{font-family:'Fraunces',Georgia,serif;font-weight:500;font-size:32px;color:var(--navy-900);margin-bottom:14px}
p{color:var(--muted);margin-bottom:28px}
.tick{width:64px;height:64px;border-radius:50%;background:var(--sky-100);color:var(--blue-600);display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 22px}
.btn{display:inline-block;padding:13px 26px;border-radius:10px;font-weight:600;font-size:15px;text-decoration:none;background:var(--blue-500);color:var(--white)}
.btn:hover{background:var(--blue-600)}
</style>
</head>
<body>
  <div class="card">
    <div class="tick">✓</div>
    <h1>Thank you</h1>
    <p>Your message has reached {{ site.name.split(" ")[0] }}. He usually replies the same day.</p>
    <a class="btn" href="/">Back to the site</a>
  </div>
</body>
</html>
